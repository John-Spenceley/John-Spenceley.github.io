        "# 1. Load a pretrained BPE tokenizer (GPT-2 uses BPE)\n",
        "# Reference: https://huggingface.co/docs/transformers/en/fast_tokenizers\n",
        "\n",
        "from transformers import AutoTokenizer\n",
        "\n",
        "# Load the pretrained GPT-2 tokenizer\n",
        "bpe_tok = AutoTokenizer.from_pretrained(\"gpt2\")\n",
        "\n",
        "# 2. Encode / decode\n",
        "def encode(text):\n",
        "    \"\"\"\n",
        "    Convert input text into a list of token IDs using the pretrained tokenizer.\n",
        "    \"\"\"\n",
        "    return bpe_tok.encode(text, add_special_tokens=False)\n",
        "\n",
        "def decode(ids):\n",
        "    \"\"\"\n",
        "    Convert a list of token IDs back into text.\n",
        "    \"\"\"\n",
        "    return bpe_tok.decode(ids)\n",
