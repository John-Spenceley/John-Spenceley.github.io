          "name": "stdout",
          "text": [
            "Sentence: The 🌟 star-player scored 40 points!\n",
            "\n",
            "--- GPT-2 Encoding ---\n",
            "Token IDs : [464, 12520, 234, 253, 3491, 12, 7829, 7781, 2319, 2173, 0]\n",
            "Decoded   : The 🌟 star-player scored 40 points!\n",
            "\n",
            "--- CL100K_BASE Encoding ---\n",
            "Token IDs : [791, 11410, 234, 253, 6917, 43467, 16957, 220, 1272, 3585, 0]\n",
            "Decoded   : The 🌟 star-player scored 40 points!\n"
          ]
        }
      ],
      "source": [
        "# Use gpt2 and cl100k_base to encode and decode the following text\n",
        "# Refer to https://github.com/openai/tiktoken\n",
        "import tiktoken\n",
        "\n",
        "sentence = \"The 🌟 star-player scored 40 points!\"\n",
        "\n",
        "# Use gpt2 and cl100k_base to encode and decode the following text\n",
        "# Refer to https://github.com/openai/tiktoken\n",
        "import tiktoken\n",
        "\n",
        "sentence = \"The 🌟 star-player scored 40 points!\"\n",
        "\n",
        "# Load the GPT-2 BPE tokenizer\n",
        "enc_gpt2 = tiktoken.get_encoding(\"gpt2\")\n",
        "\n",
        "# Load the CL100K_BASE tokenizer (used by GPT-4 and GPT-3.5-Turbo)\n",
        "enc_cl100k = tiktoken.get_encoding(\"cl100k_base\")\n",
        "\n",
        "# Encode and decode with GPT-2\n",
        "ids_gpt2 = enc_gpt2.encode(sentence)\n",
        "decoded_gpt2 = enc_gpt2.decode(ids_gpt2)\n",
        "\n",
        "# Encode and decode with CL100K_BASE\n",
        "ids_cl100k = enc_cl100k.encode(sentence)\n",
        "decoded_cl100k = enc_cl100k.decode(ids_cl100k)\n",
        "\n",
        "print(\"Sentence:\", sentence)\n",
        "\n",
        "print(\"\\n--- GPT-2 Encoding ---\")\n",
        "print(\"Token IDs :\", ids_gpt2)\n",
