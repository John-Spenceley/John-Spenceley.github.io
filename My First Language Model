        "import ipywidgets as widgets\n",
        "from IPython.display import display, Markdown\n",
        "\n",
        "# -- Sanity check: require earlier setup (MODELS, tokenizers, models, generate()) --\n",
        "try:\n",
        "    tokenizers\n",
        "    models\n",
        "    generate\n",
        "    MODELS\n",
        "except NameError as e:\n",
        "    raise RuntimeError(\"Please run the earlier setup cells that define MODELS, load models/tokenizers, and define generate().\") from e\n",
        "\n",
        "\n",
        "# =========================\n",
        "# Generation helper wrapper\n",
        "# =========================\n",
        "def generate_playground(\n",
        "    model_key,\n",
        "    prompt,\n",
        "    strategy=\"greedy\",\n",
        "    temperature=1.0,\n",
        "    max_new_tokens=100,\n",
        "    top_k=50,\n",
        "    top_p=0.9,\n",
        "    repetition_penalty=1.1,\n",
        "    no_repeat_ngram_size=3,\n",
        "    seed=None,\n",
        "):\n",
        "    \"\"\"\n",
        "    Thin wrapper over your `generate()` function with sensible defaults.\n",
        "    Returns the decoded string (no special tokens).\n",
        "    \"\"\"\n",
        "    # Normalize strategy labels\n",
        "    strategy = strategy.lower().replace(\"-\", \"_\").strip()\n",
        "\n",
        "    # Route kwargs based on strategy\n",
        "    kwargs = dict(\n",
        "        model_key=model_key,\n",
        "        prompt=prompt,\n",
        "        strategy=strategy,\n",
        "        max_new_tokens=max_new_tokens,\n",
        "        temperature=temperature,\n",
        "        repetition_penalty=repetition_penalty,\n",
        "        no_repeat_ngram_size=no_repeat_ngram_size,\n",
        "        seed=seed,\n",
        "    )\n",
        "\n",
        "    # Only pass k/p when relevant (keeps things explicit/clean)\n",
        "    if \"top_k\" in strategy:\n",
        "        kwargs[\"top_k\"] = top_k\n",
        "    if \"top_p\" in strategy:\n",
        "        kwargs[\"top_p\"] = top_p\n",
        "\n",
        "    return generate(**kwargs)\n",
        "\n",
        "\n",
        "# =========================\n",
        "# UI widgets\n",
        "# =========================\n",
        "model_dd = widgets.Dropdown(\n",
        "    options=list(MODELS.keys()),\n",
        "    value=list(MODELS.keys())[0],\n",
        "    description=\"Model:\",\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        ")\n",
        "\n",
        "strategy_dd = widgets.Dropdown(\n",
        "    options=[\n",
        "        (\"Greedy\", \"greedy\"),\n",
        "        (\"Top-k\", \"top-k\"),\n",
        "        (\"Top-p (nucleus)\", \"top-p\"),\n",
        "        (\"Top-k + Top-p\", \"top-k_top-p\"),\n",
        "        (\"Beam (4)\", \"beam\"),\n",
        "    ],\n",
        "    value=\"greedy\",\n",
        "    description=\"Strategy:\",\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        ")\n",
        "\n",
        "temperature_sl = widgets.FloatSlider(\n",
        "    value=1.0, min=0.1, max=2.0, step=0.05,\n",
        "    description=\"Temp:\",\n",
        "    readout_format=\".2f\",\n",
        "    continuous_update=False,\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        ")\n",
        "\n",
        "topk_sl = widgets.IntSlider(\n",
        "    value=50, min=1, max=200, step=1,\n",
        "    description=\"top_k:\",\n",
        "    continuous_update=False,\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        ")\n",
        "\n",
        "topp_sl = widgets.FloatSlider(\n",
        "    value=0.9, min=0.1, max=1.0, step=0.01,\n",
        "    description=\"top_p:\",\n",
        "    readout_format=\".2f\",\n",
        "    continuous_update=False,\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        ")\n",
        "\n",
        "rep_pen_sl = widgets.FloatSlider(\n",
        "    value=1.1, min=1.0, max=2.0, step=0.05,\n",
        "    description=\"Repetition:\",\n",
        "    readout_format=\".2f\",\n",
        "    continuous_update=False,\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        ")\n",
        "\n",
        "no_repeat_sl = widgets.IntSlider(\n",
        "    value=3, min=0, max=6, step=1,\n",
        "    description=\"No-repeat n:\",\n",
        "    continuous_update=False,\n",
        "    layout=widgets.Layout(width=\"260px\"),\n",
        "    tooltip=\"Set 0 to disable; 3–4 helps avoid short loops.\",\n",
        ")\n",
        "\n",
        "max_new_sl = widgets.IntSlider(\n",
        "    value=100, min=1, max=512, step=1,\n",
        "    description=\"New tokens:\",\n",
        "    continuous_update=False,\n",
        "    layout=widgets.Layout(width=\"520px\"),\n",
        ")\n",
        "\n",
        "use_seed_cb = widgets.Checkbox(value=False, description=\"Use seed\")\n",
        "seed_int = widgets.IntText(value=42, description=\"Seed:\", layout=widgets.Layout(width=\"200px\"))\n",
        "\n",
        "prompt_ta = widgets.Textarea(\n",
        "    value=\"Once upon a time,\",\n",
        "    description=\"Prompt:\",\n",
        "    layout=widgets.Layout(width=\"100%\", height=\"120px\"),\n",
        ")\n",
        "\n",
        "run_btn = widgets.Button(description=\"Generate\", button_style=\"primary\")\n",
        "clear_btn = widgets.Button(description=\"Clear Output\")\n",
        "output = widgets.Output(layout=widgets.Layout(border=\"1px solid #ddd\", padding=\"8px\"))\n",
        "\n",
        "help_md = Markdown(\n",
        "    \"**Tips**: \"\n",
        "    \"- Greedy is deterministic but can loop. \"\n",
        "    \"- Try Top-p=0.9 & Temp≈0.8 for creative but coherent results. \"\n",
        "    \"- Raise Repetition to discourage repeats; set No-repeat n to 3–4.\"\n",
        ")\n",
        "\n",
        "# Enable/disable controls depending on strategy\n",
        "def _update_control_states(*_):\n",
        "    strat = strategy_dd.value\n",
        "    is_sampling = strat in (\"top-k\", \"top-p\", \"top-k_top-p\")\n",
        "    is_beam = strat == \"beam\"\n",
        "\n",
        "    temperature_sl.disabled = not is_sampling  # greedy/beam ignore temperature\n",
        "    topk_sl.disabled = not (\"top-k\" in strat)\n",
        "    topp_sl.disabled = not (\"top-p\" in strat)\n",
        "\n",
        "    # Always useful:\n",
        "    rep_pen_sl.disabled = False\n",
        "    no_repeat_sl.disabled = False\n",
        "\n",
        "strategy_dd.observe(_update_control_states, names=\"value\")\n",
        "_update_control_states()\n",
        "\n",
        "# Click handlers\n",
        "def on_generate_clicked(_):\n",
        "    with output:\n",
        "        output.clear_output(wait=True)\n",
        "        try:\n",
        "            seed_val = seed_int.value if use_seed_cb.value else None\n",
        "            text = generate_playground(\n",
        "                model_key=model_dd.value,\n",
        "                prompt=prompt_ta.value,\n",
        "                strategy=strategy_dd.value,\n",
        "                temperature=temperature_sl.value,\n",
        "                max_new_tokens=max_new_sl.value,\n",
        "                top_k=topk_sl.value,\n",
        "                top_p=topp_sl.value,\n",
        "                repetition_penalty=rep_pen_sl.value,\n",
        "                no_repeat_ngram_size=no_repeat_sl.value,\n",
        "                seed=seed_val,\n",
        "            )\n",
        "            display(Markdown(f\"**Model:** `{model_dd.value}` &nbsp;&nbsp; **Strategy:** `{strategy_dd.label}`\"))\n",
        "            display(Markdown(f\"**Output**:\\n\\n```\\n{text}\\n```\"))\n",
        "        except Exception as e:\n",
        "            display(Markdown(f\"**Error:** `{type(e).__name__}` – {e}\"))\n",
        "\n",
        "def on_clear_clicked(_):\n",
        "    output.clear_output()\n",
        "\n",
        "run_btn.on_click(on_generate_clicked)\n",
        "clear_btn.on_click(on_clear_clicked)\n",
        "\n",
        "# Layout\n",
        "row1 = widgets.HBox([model_dd, strategy_dd, temperature_sl])\n",
        "row2 = widgets.HBox([topk_sl, topp_sl, rep_pen_sl])\n",
        "row3 = widgets.HBox([no_repeat_sl])\n",
        "row4 = widgets.HBox([max_new_sl])\n",
        "row5 = widgets.HBox([use_seed_cb, seed_int])\n",
        "buttons = widgets.HBox([run_btn, clear_btn])\n",
        "\n",
        "display(help_md)\n",
        "display(prompt_ta)\n",
        "display(row1, row2, row3, row4, row5, buttons, output)\n"
      ]
    },
