      "metadata": {
        "id": "91607661"
      },
      "source": [
        "### 3.2 - Top-k or top-p sampling"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "0633d4a3",
      "metadata": {
        "id": "0633d4a3"
      },
      "outputs": [],
      "source": [
        "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
        "import torch\n",
        "\n",
        "MODELS = {\n",
        "    \"gpt2\": \"gpt2\",\n",
        "    \"qwen\": \"Qwen/Qwen1.5-1.8B-Chat\",\n",
        "}\n",
        "\n",
        "tokenizers, models = {}, {}\n",
        "\n",
        "def load(model_key):\n",
        "    if model_key in tokenizers and model_key in models:\n",
        "        return tokenizers[model_key], models[model_key]\n",
        "    name = MODELS[model_key]\n",
        "    tok = AutoTokenizer.from_pretrained(name)\n",
        "    mdl = AutoModelForCausalLM.from_pretrained(\n",
        "        name,\n",
        "        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,\n",
        "        device_map=\"auto\" if torch.cuda.is_available() else None,\n",
        "    )\n",
        "    # Many decoder-only models lack a pad_token; use eos_token for padding to silence warnings\n",
        "    if tok.pad_token_id is None and tok.eos_token_id is not None:\n",
        "        tok.pad_token = tok.eos_token\n",
        "    mdl.eval()\n",
        "    tokenizers[model_key], models[model_key] = tok, mdl\n",
        "    return tok, mdl\n",
        "\n",
        "def generate(\n",
        "    model_key,\n",
        "    prompt,\n",
        "    strategy=\"greedy\",\n",
        "    max_new_tokens=100,\n",
        "    temperature=1.0,\n",
        "    top_k=50,\n",
        "    top_p=0.9,\n",
        "    repetition_penalty=1.1,\n",
        "    no_repeat_ngram_size=3,\n",
        "    seed=None,\n",
        "):\n",
        "    tok, mdl = load(model_key)\n",
        "\n",
        "    # Normalize strategy label(s)\n",
        "    strat = strategy.lower().replace(\"-\", \"_\").strip()\n",
        "\n",
        "    # Seeding (optional, makes sampling repeatable)\n",
        "    if seed is not None:\n",
        "        torch.manual_seed(seed)\n",
        "        if torch.cuda.is_available():\n",
        "            torch.cuda.manual_seed_all(seed)\n",
        "\n",
        "    inputs = tok(prompt, return_tensors=\"pt\")\n",
        "    inputs = {k: v.to(mdl.device) for k, v in inputs.items()}\n",
        "\n",
        "    # Decide sampling flags\n",
        "    do_sample = strat in {\"top_k\", \"top_p\", \"top_k_top_p\", \"sampling\"}\n",
        "    use_top_k = (\"top_k\" in strat)\n",
        "    use_top_p = (\"top_p\" in strat)\n",
        "\n",
        "    gen_kwargs = dict(\n",
        "        max_new_tokens=max_new_tokens,\n",
        "        do_sample=do_sample,\n",
        "        temperature=temperature if do_sample else 1.0,\n",
        "        repetition_penalty=repetition_penalty,\n",
        "        no_repeat_ngram_size=no_repeat_ngram_size,\n",
        "        pad_token_id=tok.pad_token_id,\n",
        "        eos_token_id=tok.eos_token_id,\n",
        "        use_cache=True,\n",
        "    )\n",
        "    if do_sample:\n",
        "        if use_top_k:\n",
        "            gen_kwargs[\"top_k\"] = top_k\n",
        "        if use_top_p:\n",
        "            gen_kwargs[\"top_p\"] = top_p\n",
        "\n",
        "    # Beam search (optional)\n",
        "    if strat == \"beam\":\n",
        "        gen_kwargs.update(dict(num_beams=4, early_stopping=True, do_sample=False))\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = mdl.generate(**inputs, **gen_kwargs)\n",
        "\n",
        "    return tok.decode(outputs[0], skip_special_tokens=True)\n"
      ]
    },
